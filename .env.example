# Copy to .env.local for local development. Never commit real values.

# Supabase project (Settings → API). The service-role key is used ONLY on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signs the prototype session cookie. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# OpenAI. Leave OPENAI_API_KEY empty to run without live AI (the app says so clearly).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Fixed "today" for the fictional sample data so demo numbers stay stable (e.g. $62,000 / 11 estimates).
DEMO_TODAY=2026-11-08
